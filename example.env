# Server Environment Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Security & Authentication
JWT_SECRET=geonet-super-secret-production-grade-key-change-in-prod-2026
JWT_EXPIRES_IN=3600s
JWT_REFRESH_SECRET=geonet-refresh-super-secret-key-change-in-prod-2026
JWT_REFRESH_EXPIRES_IN=7d
SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Configuration (Dual-Engine: postgres or sqlite)
DATABASE_ENGINE=sqlite
DATABASE_FILE=./data/geonet_sentinel.sqlite
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=geonet_sentinel
POSTGRES_SSL=false

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Network Prober Daemon
PROBER_CONCURRENCY=10
PROBER_DEFAULT_INTERVAL_SECONDS=30
PROBER_TIMEOUT_MS=5000

# Telemetry & GPS Ingestion
MAX_GPS_SPEED_KPH=300
GPS_JITTER_THRESHOLD_METERS=15
LOCATION_RATE_LIMIT_PER_MINUTE=120

# Simulation Presets
SIMULATION_DEFAULT_DEVICE_COUNT=25
SIMULATION_DEFAULT_NODE_COUNT=15
SIMULATION_TICK_RATE_MS=1000

# Worker & Reporting
WORKER_PORT=4001
REPORT_STORAGE_PATH=./storage/reports
LOG_LEVEL=info